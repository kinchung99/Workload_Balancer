# ─────────────────────────────────────────────────────────────────────────────
# You do NOT need this file to run Ballast locally.
#
#   npm run dev
#
# starts the API on a local Postgres file (.data/ballast) with no accounts,
# no cloud and no connection string. Real sign-ups and real friends work.
#
# Copy this to .env only when you are deploying to a hosted database.
# ─────────────────────────────────────────────────────────────────────────────

# Neon (neon.tech) gives a free serverless Postgres. Paste the pooled URL here.
# Leave it blank or delete the line to keep using the local file.
DATABASE_URL=

# openssl rand -base64 32
# Any string works locally. Set a real one before deploying.
AUTH_SECRET=

# The public URL of THIS api. https:// switches cookies to cross-site mode,
# so leave it as http://localhost:8787 while developing.
BASE_URL=http://localhost:8787

# Only enforced when BASE_URL is https. In development every localhost port and
# local-network address is trusted, because Metro's port and your phone's IP move.
TRUSTED_ORIGINS=https://load-balancer-ballast.expo.app

# Optional. Without these the app still has email + password.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

{
  "//": "Root config so Vercel compiles the function the same way the server does. Without one it falls back to defaults that reject this codebase's import style.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "lib": ["ES2023"]
  },
  "include": ["api/**/*.ts", "server/src/**/*.ts", "shared/**/*.ts"],
  "exclude": ["node_modules", "ballast"]
}

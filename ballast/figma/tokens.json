{
  "$description": "Ballast design tokens. W3C DTCG format. Import into Figma with the Tokens Studio plugin (Settings > Use DTCG format ON), then Import > tokens.json, then 'Create variables'. This file is the single source of truth; src/design/tokens.ts mirrors it and scripts/verify-tokens.mjs fails the build if they drift.",
  "color": {
    "$description": "Figma collection: Colour. Mode: Light (default) and Dark.",
    "band": {
      "$description": "The four load bands. Every band is a colour AND a word AND a fill pattern - see asset/pattern tokens. Nothing in Ballast is encoded in colour alone.",
      "steady": {
        "fill":  { "$type": "color", "$value": "#2F8265", "$description": "Steady, under 70%. Bar fill. 4.66:1 on white." },
        "ink":   { "$type": "color", "$value": "#1B5C46", "$description": "Steady text. 7.88:1 on white." },
        "wash":  { "$type": "color", "$value": "#E8F2ED", "$description": "Steady card background." },
        "onDark":{ "$type": "color", "$value": "#5FBF98", "$description": "Steady on the dark lock-screen surface. 7.57:1." }
      },
      "busy": {
        "fill":  { "$type": "color", "$value": "#C4881B", "$description": "Busy, 70 to 85%. Bar fill. 3.05:1 on white." },
        "ink":   { "$type": "color", "$value": "#7A5200", "$description": "Busy text. 6.92:1 on white." },
        "wash":  { "$type": "color", "$value": "#FBF0DC", "$description": "Busy card background." },
        "onDark":{ "$type": "color", "$value": "#E8B45C", "$description": "Busy on dark. 8.96:1." }
      },
      "heavy": {
        "fill":  { "$type": "color", "$value": "#B32540", "$description": "Heavy, over 85%. Bar fill. 6.45:1 on white." },
        "ink":   { "$type": "color", "$value": "#A31C38", "$description": "Heavy text. 7.55:1 on white." },
        "wash":  { "$type": "color", "$value": "#FBE9EC", "$description": "Heavy card background." },
        "onDark":{ "$type": "color", "$value": "#E4607D", "$description": "Heavy on dark. 5.05:1." }
      },
      "recovery": {
        "fill":  { "$type": "color", "$value": "#6B95C9", "$description": "Recovery, load you get back. 3.10:1 on white." },
        "ink":   { "$type": "color", "$value": "#2C5C8F", "$description": "Recovery text. 6.92:1 on white." },
        "wash":  { "$type": "color", "$value": "#EAF1F9", "$description": "Recovery card background." },
        "onDark":{ "$type": "color", "$value": "#9EC1E8", "$description": "Recovery on dark. 9.06:1." }
      }
    },
    "area": {
      "$description": "Identity colours for the five areas. Used ONLY on icons and tile washes - never on a reading. Colour on a bar, a number or the battery still means which band it is in, and these are deliberately a different family so the two channels never compete.",
      "mental":   { "ink": { "$type": "color", "$value": "#6B3FC0" }, "wash": { "$type": "color", "$value": "#F0EAFC" } },
      "time":     { "ink": { "$type": "color", "$value": "#0C6E8F" }, "wash": { "$type": "color", "$value": "#E2F1F7" } },
      "physical": { "ink": { "$type": "color", "$value": "#4F7A1E" }, "wash": { "$type": "color", "$value": "#EEF5E2" } },
      "social":   { "ink": { "$type": "color", "$value": "#A63A8C" }, "wash": { "$type": "color", "$value": "#FAE9F5" } },
      "errands":  { "ink": { "$type": "color", "$value": "#5A5560" }, "wash": { "$type": "color", "$value": "#F1F0F3" } }
    },
    "decor": {
      "$description": "Decoration only: stickers, confetti, blobs behind a heading. Nothing on screen is ever READ off one of these. They live in their own group precisely so the 'colour means band' rule stays checkable - if a decor hue ever turns up on a bar, a number or a meter, that is a bug.",
      "blush": { "$type": "color", "$value": "#FF8FAB", "$description": "Cheeks, hearts, the pressed state of a sticker." },
      "candy": { "$type": "color", "$value": "#FFB3D1", "$description": "Soft pink. Sticker fills." },
      "lemon": { "$type": "color", "$value": "#FFD37A", "$description": "Warm yellow. Sparkles and stars." },
      "mint":  { "$type": "color", "$value": "#8FE0C2", "$description": "Fresh green. Sticker fills." },
      "sky":   { "$type": "color", "$value": "#9CCDF5", "$description": "Light blue. Sticker fills." },
      "lilac": { "$type": "color", "$value": "#C4A9F0", "$description": "Soft purple. Sticker fills." },
      "cream": { "$type": "color", "$value": "#FFF7EC", "$description": "The warm paper the capture flow sits on." }
    },
    "surface": {
      "page":    { "$type": "color", "$value": "#FFFFFF", "$description": "App page background." },
      "raised":  { "$type": "color", "$value": "#FFFFFF", "$description": "Card background on page." },
      "sunken":  { "$type": "color", "$value": "#F6F5F2", "$description": "Grouped background, chips, inactive fields." },
      "track":   { "$type": "color", "$value": "#EDEBE6", "$description": "Unfilled portion of any bar or meter." },
      "inverse": { "$type": "color", "$value": "#16261F", "$description": "Primary button fill and dark deck panels." },
      "night":   { "$type": "color", "$value": "#1C1D1B", "$description": "Lock screen and widget surface." }
    },
    "ink": {
      "default": { "$type": "color", "$value": "#14161A", "$description": "Body and heading text. 18.1:1 on white." },
      "muted":   { "$type": "color", "$value": "#565A62", "$description": "Secondary text. 6.92:1 on white." },
      "subtle":  { "$type": "color", "$value": "#6B7079", "$description": "Metadata and captions. 4.98:1 on white, 4.57:1 on sunken." },
      "inverse": { "$type": "color", "$value": "#F7F6F2", "$description": "Text on inverse and night surfaces." },
      "onNightMuted": { "$type": "color", "$value": "#A8A9A3", "$description": "Secondary text on night. 7.15:1." }
    },
    "line": {
      "hairline": { "$type": "color", "$value": "#E4E2DC", "$description": "1pt row and card separator." },
      "strong":   { "$type": "color", "$value": "#C9C6BE", "$description": "Focus outline and toggle border." },
      "ceiling":  { "$type": "color", "$value": "#9A9790", "$description": "The dashed 'your ceiling' rule." }
    },
    "control": {
      "onFill":    { "$type": "color", "$value": "#2F8265", "$description": "Switch track when on." },
      "offFill":   { "$type": "color", "$value": "#D8D5CE", "$description": "Switch track when off." },
      "lockedFill":{ "$type": "color", "$value": "#EDEBE6", "$description": "Switch track when the item is a hard deadline and cannot move." },
      "knob":      { "$type": "color", "$value": "#FFFFFF", "$description": "Switch knob." }
    }
  },
  "dimension": {
    "$description": "Figma collection: Dimension. 4pt base grid.",
    "space": {
      "0":  { "$type": "dimension", "$value": "0px" },
      "1":  { "$type": "dimension", "$value": "2px" },
      "2":  { "$type": "dimension", "$value": "4px" },
      "3":  { "$type": "dimension", "$value": "8px" },
      "4":  { "$type": "dimension", "$value": "12px" },
      "5":  { "$type": "dimension", "$value": "16px", "$description": "Default gutter. Screen horizontal padding." },
      "6":  { "$type": "dimension", "$value": "20px" },
      "7":  { "$type": "dimension", "$value": "24px" },
      "8":  { "$type": "dimension", "$value": "32px" },
      "9":  { "$type": "dimension", "$value": "40px" },
      "10": { "$type": "dimension", "$value": "48px" }
    },
    "radius": {
      "sm":   { "$type": "dimension", "$value": "8px" },
      "md":   { "$type": "dimension", "$value": "12px", "$description": "Cards." },
      "lg":   { "$type": "dimension", "$value": "16px", "$description": "Buttons and large cards." },
      "xl":   { "$type": "dimension", "$value": "20px" },
      "pill": { "$type": "dimension", "$value": "999px", "$description": "Chips, bands, bars." }
    },
    "target": {
      "min":     { "$type": "dimension", "$value": "44px", "$description": "WCAG 2.5.5 minimum tappable target. Applies to dread dots too." },
      "button":  { "$type": "dimension", "$value": "52px", "$description": "Primary button height." },
      "row":     { "$type": "dimension", "$value": "56px", "$description": "Minimum list row height." },
      "tabBar":  { "$type": "dimension", "$value": "56px" }
    },
    "bar": {
      "bucket":   { "$type": "dimension", "$value": "12px", "$description": "Bucket bar height on Home." },
      "meter":    { "$type": "dimension", "$value": "10px", "$description": "Rebalance live meter height." },
      "forecast": { "$type": "dimension", "$value": "96px", "$description": "Forecast strip max column height." }
    },
    "frame": {
      "width":  { "$type": "dimension", "$value": "390px", "$description": "Figma artboard width. iPhone 16 / 14 Pro logical points." },
      "height": { "$type": "dimension", "$value": "844px", "$description": "Figma artboard height." },
      "safeTop":    { "$type": "dimension", "$value": "59px" },
      "safeBottom": { "$type": "dimension", "$value": "34px" }
    }
  },
  "typography": {
    "$description": "Figma collection: Type. Maps 1:1 to Figma text styles. Scale is iOS Dynamic Type compatible and every layout holds at 200%.",
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["-apple-system", "SF Pro Text", "Roboto", "Inter", "system-ui", "sans-serif"] }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    },
    "style": {
      "hero":     { "$type": "typography", "$value": { "fontSize": "56px", "lineHeight": "60px", "fontWeight": 700, "letterSpacing": "-2px" }, "$description": "The one capacity number. Home and Calm mode." },
      "display":  { "$type": "typography", "$value": { "fontSize": "40px", "lineHeight": "44px", "fontWeight": 700, "letterSpacing": "-1.2px" }, "$description": "Recovery balance. Rebalance target %." },
      "title":    { "$type": "typography", "$value": { "fontSize": "24px", "lineHeight": "30px", "fontWeight": 700, "letterSpacing": "-0.5px" }, "$description": "Screen titles." },
      "heading":  { "$type": "typography", "$value": { "fontSize": "18px", "lineHeight": "24px", "fontWeight": 600, "letterSpacing": "-0.2px" }, "$description": "Card headings, alert headlines." },
      "body":     { "$type": "typography", "$value": { "fontSize": "16px", "lineHeight": "23px", "fontWeight": 400 }, "$description": "Default. Item titles use weight 600." },
      "callout":  { "$type": "typography", "$value": { "fontSize": "15px", "lineHeight": "21px", "fontWeight": 400 } },
      "footnote": { "$type": "typography", "$value": { "fontSize": "13px", "lineHeight": "18px", "fontWeight": 400 }, "$description": "Row metadata: hours, commitment type, deadline." },
      "caption":  { "$type": "typography", "$value": { "fontSize": "12px", "lineHeight": "16px", "fontWeight": 500, "letterSpacing": "0.2px" }, "$description": "Chips, band labels, tab bar." },
      "micro":    { "$type": "typography", "$value": { "fontSize": "11px", "lineHeight": "14px", "fontWeight": 600, "letterSpacing": "0.4px" }, "$description": "Forecast day letters, axis labels." }
    }
  },
  "pattern": {
    "$description": "The non-colour half of every band. Print the app in greyscale and all four states remain distinguishable. In Figma these are four re-usable SVG pattern swatches on the Foundations page.",
    "steady":   { "$type": "other", "$value": "flat",     "$description": "Solid fill, no texture." },
    "busy":     { "$type": "other", "$value": "diagonal", "$description": "45 degree stripes, 6px pitch, 2px stroke." },
    "heavy":    { "$type": "other", "$value": "cross",    "$description": "Cross hatch, 6px pitch, 1.6px stroke." },
    "recovery": { "$type": "other", "$value": "vertical", "$description": "Vertical rules, 5px pitch, 2px stroke." }
  },
  "threshold": {
    "$description": "The numbers the product is built on. Kept as tokens so the deck, the app and Figma annotations cannot disagree.",
    "steadyMax":     { "$type": "number", "$value": 70,  "$description": "Under 70% is Steady." },
    "busyMax":       { "$type": "number", "$value": 85,  "$description": "70 to 85% is Busy. Above is Heavy." },
    "calmMode":      { "$type": "number", "$value": 90,  "$description": "At or above 90% the interface collapses to one number, one sentence, one button." },
    "dreadMin":      { "$type": "number", "$value": 1 },
    "dreadMax":      { "$type": "number", "$value": 5 },
    "forecastDays":  { "$type": "number", "$value": 14, "$description": "Forecast horizon." },
    "warningLeadDays": { "$type": "number", "$value": 8, "$description": "How early a collision is flagged. Long enough to email a tutor or swap a shift." },
    "clusterWindowHours": { "$type": "number", "$value": 72, "$description": "We flag clustering, not totals. Four things inside this window is a wall." }
  },
  "motion": {
    "$description": "The only animation in the app is the meter moving as you toggle trade-offs, because it shows what changed. Reduced motion cuts to the new value.",
    "meter": { "$type": "duration", "$value": "260ms" },
    "none":  { "$type": "duration", "$value": "0ms" }
  }
}

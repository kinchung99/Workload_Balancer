{
  "name": "ballast",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "tokens:check": "node scripts/verify-tokens.mjs",
    "model:check": "node scripts/check-model.mjs",
    "render:check": "node scripts/check-render.mjs",
    "deploy": "npm run preflight && expo export --platform web --clear && eas deploy --prod",
    "preflight": "npm run typecheck && npm run tokens:check && npm run model:check && npm run behaviour:check && npm run render:check",
    "behaviour:check": "node scripts/check-behaviour.mjs",
    "shots": "node scripts/screenshots.mjs",
    "clips": "node scripts/clips.mjs",
    "titles": "node scripts/titles.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "expo": {
    "install": {
      "exclude": []
    }
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.0",
    "eas-cli": "^23.2.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}

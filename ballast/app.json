{
  "expo": {
    "name": "Ballast",
    "slug": "load-balancer-ballast",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ballast",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kcchung.ballast",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kcchung.ballast"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "resizeMode": "contain"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "kc699",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "04e096f1-4ec2-4626-93ea-7f1ecabc4b6e"
      }
    }
  }
}
